{
  "schemaVersion": 2,
  "$comment": "jobs packs short lanes into one CI job each (docs/ci.md, Contract lane packing); every other lane is a job of its own. images: false marks a lane that loads no prebuilt image, so its jobs start without waiting for build-images. A pack runs its lanes in the listed order on one Docker daemon, so perf-load comes first and measures a clean daemon.",
  "jobs": {
    "packed-perf-integration": [
      "perf-load",
      "core-integration-1"
    ],
    "packed-checks-backup": [
      "core-checks",
      "core-backup"
    ],
    "packed-nuget-migrations": [
      "nuget",
      "oci-migration",
      "npm-migration"
    ],
    "packed-maven-clients": [
      "maven-oci-auth",
      "migration-clients"
    ],
    "packed-rubygems-discovery-auth": [
      "rubygems",
      "oci-discovery",
      "six-format-auth"
    ],
    "packed-inventory-helm-pypi": [
      "inventory",
      "helm",
      "pypi-migration"
    ]
  },
  "lanes": {
    "core-checks": {
      "timeoutMinutes": 30,
      "arm64": "pull-request",
      "needs": [
        "rust",
        "node",
        "npm"
      ],
      "images": false,
      "steps": [
        {
          "name": "CI lane control contracts",
          "command": [
            "python3",
            "-B",
            "-m",
            "unittest",
            "discover",
            "-s",
            "scripts/tests",
            "-p",
            "test_ci_contract.py"
          ],
          "timeoutSeconds": null
        },
        {
          "name": "openapi-check",
          "command": [
            "make",
            "openapi-check"
          ],
          "timeoutSeconds": null
        },
        {
          "name": "cli-contract-check",
          "command": [
            "make",
            "cli-contract-check"
          ],
          "timeoutSeconds": null
        },
        {
          "name": "cli-test",
          "command": [
            "make",
            "cli-test"
          ],
          "timeoutSeconds": null
        },
        {
          "name": "test",
          "command": [
            "make",
            "test"
          ],
          "timeoutSeconds": null
        },
        {
          "name": "cargo-contract",
          "command": [
            "make",
            "cargo-contract"
          ],
          "timeoutSeconds": null
        },
        {
          "name": "kubernetes-local-check",
          "command": [
            "make",
            "kubernetes-local-check"
          ],
          "timeoutSeconds": null
        },
        {
          "name": "release-readiness-check",
          "command": [
            "make",
            "release-readiness-check"
          ],
          "timeoutSeconds": null
        }
      ],
      "rawDirectories": []
    },
    "core-email": {
      "timeoutMinutes": 25,
      "arm64": "pull-request",
      "needs": [
        "node"
      ],
      "images": true,
      "steps": [
        {
          "name": "email-compose-check",
          "command": [
            "make",
            "email-compose-check"
          ],
          "timeoutSeconds": null
        }
      ],
      "rawDirectories": []
