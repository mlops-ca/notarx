# Copy to .env and change values before starting the fixture. Do not commit .env.
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_POSTGRES_PASSWORD=replace-with-a-local-password
GITEA_ADMIN_USERNAME=fixture-admin
GITEA_ADMIN_PASSWORD=replace-with-a-local-admin-password
GITEA_ADMIN_EMAIL=fixture-admin@example.test
GITEA_FIXTURE_USERNAME=notarx-fixture
GITEA_FIXTURE_PASSWORD=replace-with-a-local-fixture-password
GITEA_FIXTURE_EMAIL=notarx-fixture@example.test
GITEA_FIXTURE_ORG=notarx-fixtures

# Gateway development stack. Use distinct local-only values; never commit .env.
NOTARX_HTTP_PORT=8080
# Optional externally visible base URL: https://, no trailing slash (http:// only
# for loopback). Empty disables the features that need it.
# NOTARX_PUBLIC_URL=https://notarx.example.com
NOTARX_CONSOLE_PORT=4173
# Optional directory of validated *.theme.json packages. The local Compose
# stack mounts ./themes read-only at /themes.
NOTARX_CONSOLE_THEME_DIR=/themes
# Optional runtime file mirror; disabled until a writable absolute directory is
# explicitly provisioned. These limits apply per session, not across restarts.
# NOTARX_LOG_FILE_DIRECTORY=/var/log/notarx
# NOTARX_LOG_FILE_MAX_BYTES=104857600
# NOTARX_LOG_FILE_MAX_BACKUPS=10
# NOTARX_LOG_FILE_MAX_AGE=168h
# Optional OTLP/HTTP protobuf Logs mirror, separate from trace configuration.
# Disabled until a deployment-managed receiver is explicitly configured.
# NOTARX_OTLP_LOGS_ENDPOINT=https://collector.example.test/v1/logs
# NOTARX_OTLP_LOGS_HEADERS={"Authorization":"Bearer replace-with-a-collector-token"}
# Capacity includes queued and in-flight records; overflow rejects new events.
# NOTARX_OTLP_LOGS_QUEUE_SIZE=256
# NOTARX_OTLP_LOGS_TIMEOUT=3s
# Each protocol flush and shutdown has this budget; file I/O is separate.
# NOTARX_OTLP_LOGS_SHUTDOWN_TIMEOUT=5s
NOTARX_POSTGRES_PORT=5432
NOTARX_POSTGRES_PASSWORD=replace-with-a-local-notarx-db-password
# Runtime placement. The default standalone role expands to api,scheduler,worker.
# Cluster examples:
#   API node:       NOTARX_NODE_ROLES=api
#   scheduler node: NOTARX_NODE_ROLES=scheduler
#   OCI workers:    NOTARX_NODE_ROLES=worker and NOTARX_WORKER_FORMATS=oci
NOTARX_NODE_ROLES=standalone
# One-time defaults for a new empty installation; use none to start empty.
# Administrator edits/deletions and existing catalogs are never overwritten.
NOTARX_REPOSITORY_PRESETS=standard
# Traditional HTTP Helm Hosted preview; separate from admitted formats.
NOTARX_HELM_PREVIEW_ENABLED=false
# Opt-in NuGet H/P/G and RubyGems Hosted previews; no formal format admission.
NOTARX_NUGET_PREVIEW_ENABLED=false
NOTARX_RUBYGEMS_PREVIEW_ENABLED=false
NOTARX_INSTANCE_ID=
# Worker filters apply to format-specific lifecycle work and global job kinds,
# including webhook delivery. Unset means all formats and kinds.
NOTARX_WORKER_FORMATS=
NOTARX_WORKER_KINDS=
# Optional artifact scanner. Setting the endpoint enables the configurable
# HTTP adapter; HTTPS is required outside localhost. For the bundled Trivy
# reference adapter, set COMPOSE_PROFILES=scanner and use the loopback values
# below because the scanner shares Gateway's network namespace.
COMPOSE_PROFILES=
NOTARX_SCANNER_ENDPOINT=
NOTARX_SCANNER_HEALTH_ENDPOINT=
NOTARX_SCANNER_NAME=
NOTARX_SCANNER_TOKEN=
NOTARX_SCANNER_TIMEOUT=
NOTARX_SCANNER_HEALTH_TIMEOUT=
# Scanner vulnerability databases older than this are reported as stale.
NOTARX_SCANNER_DATABASE_MAX_AGE=
NOTARX_SCANNER_MAX_RESPONSE_BYTES=
NOTARX_SCANNER_MAX_ARTIFACT_BYTES=
# Comma-separated scanner formats; unset means all supported repository formats.
NOTARX_SCANNER_FORMATS=
# Bundled reference-scanner example:
# COMPOSE_PROFILES=scanner
# NOTARX_SCANNER_ENDPOINT=http://127.0.0.1:18082/v1/scan
# NOTARX_SCANNER_HEALTH_ENDPOINT=http://127.0.0.1:18082/v1/health
# NOTARX_SCANNER_NAME=trivy-reference
# NOTARX_SCANNER_FORMATS=maven,raw,npm,pypi,go,conan
# NOTARX_SCANNER_TOKEN=replace-with-a-local-scanner-token
# NOTARX_SCANNER_TIMEOUT=10m
# NOTARX_SCANNER_MAX_ARTIFACT_BYTES=1073741824
# REFERENCE_SCANNER_MAX_ARTIFACT_BYTES=1073741824
# REFERENCE_SCANNER_MAX_OUTPUT_BYTES=67108864
# REFERENCE_SCANNER_MAX_CONCURRENT=1
# REFERENCE_SCANNER_MAX_SBOM_BYTES=2147483648

# Optional exact archive recovery, independent of signer configuration. Configure
# both values; mount the public-only keyring at this path using a Compose override.
# NOTARX_APT_RESTORE_TRUSTED_FINGERPRINTS=
# NOTARX_APT_RESTORE_TRUSTED_PUBLIC_KEYS_FILE=/run/secrets/apt-restore-public-keys.asc

# Optional local APT Hosted H2 signing sidecar (`docker compose --profile apt-signer up`).
# Gateway and signer share only loopback networking; the private key stays in
# the notarx-apt-signer volume mounted exclusively into the signer container.
# NOTARX_APT_SIGNER_ENDPOINT=http://127.0.0.1:18083/v1/sign-release
# NOTARX_APT_SIGNER_TOKEN=replace-with-at-least-32-random-bytes
# NOTARX_APT_SIGNER_TIMEOUT=15s
# A remote production signer requires one active fingerprint and accepts one
# optional next fingerprint during a controlled rotation overlap.
# NOTARX_APT_SIGNER_TRUSTED_FINGERPRINTS=
# Mount the matching armored public-key ring read-only into Gateway. Remote
# signing is rejected unless this keyring and the configured fingerprints agree.
# NOTARX_APT_SIGNER_TRUSTED_PUBLIC_KEYS_FILE=/run/secrets/apt-release-public-keys.asc
# Optional private-CA bundle used only by the APT signer HTTP client. Public-CA
# signers should leave this empty; the file must be mounted read-only.
# NOTARX_APT_SIGNER_TLS_CA_FILE=/run/secrets/apt-signer-ca.pem
# REFERENCE_APT_SIGNER_RSA_BITS=4096
# REFERENCE_APT_SIGNER_MAX_RELEASE_BYTES=16777216
# The primary pool serves requests and background jobs. Reduce all pool limits
# per replica when many Gateway instances share the same PostgreSQL server.
NOTARX_DATABASE_MAX_OPEN_CONNS=32
NOTARX_DATABASE_MAX_IDLE_CONNS=8
# Cache coordination locks hold connections for the duration of cache fills.
NOTARX_DATABASE_COORDINATOR_MAX_OPEN_CONNS=8
NOTARX_DATABASE_COORDINATOR_MAX_IDLE_CONNS=2
# Artifact publication and quarantine locks use a separate pool. One operation
# holds at most one of these connections even for a multi-file artifact.
NOTARX_DATABASE_ARTIFACT_LOCK_MAX_OPEN_CONNS=4
NOTARX_DATABASE_ARTIFACT_LOCK_MAX_IDLE_CONNS=1
# Two additional connections are reserved for multiplexed LISTEN/NOTIFY work.
NOTARX_DATABASE_CONN_MAX_LIFETIME=30m
NOTARX_DATABASE_CONN_MAX_IDLE_TIME=5m
NOTARX_ADMIN_TOKEN=replace-with-a-local-notarx-admin-token
NOTARX_RESOLVER_TOKEN=replace-with-a-local-notarx-resolver-token
# Independent Conan 2 protocol signing secret (at least 32 bytes); empty disables native login.
# Generate separately from login credentials: openssl rand -hex 32
NOTARX_CONAN_TOKEN_SECRET=
NOTARX_LOCAL_AUTH_MAX_FAILED_ATTEMPTS=5
NOTARX_LOCAL_AUTH_LOCKOUT_DURATION=15m
# Workload JWT verification (ADR 0019); commented values are the defaults. The skew applies to
# exp, nbf and iat (at most 5m), the age cap to now-iat and exp-iat, the TTL to each issuer's
# cached keys, and the stale limit to how long expired keys are served when a refresh fails.
# NOTARX_WORKLOAD_CLOCK_SKEW=60s
# NOTARX_WORKLOAD_MAX_TOKEN_AGE=1h
# NOTARX_WORKLOAD_JWKS_TTL=10m
# NOTARX_WORKLOAD_JWKS_STALE_MAX=24h
# SAML service provider limits (ADR 0018 section 3). The skew applies to NotBefore and
# NotOnOrAfter and extends the assertion replay window (at most 5m); the request TTL is how
# long an AuthnRequest id can be redeemed; the byte cap bounds the posted response.
# NOTARX_SAML_CLOCK_SKEW=60s
# NOTARX_SAML_REQUEST_TTL=10m
# NOTARX_SAML_MAX_RESPONSE_BYTES=1048576
# How often SAML providers that turned metadata refresh on re-import their metadata URL; the
# refresh is off per provider by default. A new certificate is added as `next`.
# NOTARX_SAML_METADATA_REFRESH_INTERVAL=24h
# 32-byte key (hex/base64/raw) encrypting stored egress proxy credentials.
# Generate with: openssl rand -hex 32
NOTARX_EGRESS_PROXY_KEY=
# 32-byte key used to encrypt runtime-managed authentication credentials.
NOTARX_SETTINGS_ENCRYPTION_KEY=
# Retired keys, comma-separated (hex or base64), kept readable while
# `notarxctl secrets reseal` rewrites stored values. Empty when not rotating.
NOTARX_SETTINGS_ENCRYPTION_KEY_PREVIOUS=
NOTARX_REPOSITORY_READERS=
# Legacy repository reads deny an unmatched authenticated caller when no reader
# patterns are configured. Set to `allow` only to stage an upgrade that still has
# to inventory the actors reading without a grant: notarx logs a startup
# warning while it is set, and every other value fails closed.
NOTARX_LEGACY_READ_DEFAULT=
# Optional logical cache quotas in bytes: repository=bytes;repository=bytes.
# OCI repository names include their namespace (for example team/app); Maven
# repository names are their configured Gateway group names.
NOTARX_REPOSITORY_CACHE_QUOTAS=
# Optional OIDC bearer-token validation. When enabled, the JWT `sub` is the
# repository-read identity; configure NOTARX_REPOSITORY_READERS for those subjects.
# Issuer and JWKS endpoints must use HTTPS, except for localhost/127.0.0.1/::1
# during local development.
NOTARX_OIDC_ISSUER=
NOTARX_OIDC_AUDIENCE=
NOTARX_OIDC_JWKS_URL=
# Optional browser SSO. These NOTARX_OIDC_* values only seed the identity provider
# registry: when it is empty at startup they create one provider with slug
# "default", so the redirect URL is <public URL>/auth/oidc/default/callback.
# Later changes are made through the management API or the Console, not here.
# The Console discovers the enabled providers from the Gateway, so changing
# providers does not require rebuilding the frontend.
# Client secret is optional for public PKCE clients. HTTP callbacks are only
# accepted for localhost development.
NOTARX_OIDC_CLIENT_ID=
NOTARX_OIDC_CLIENT_SECRET=
NOTARX_OIDC_REDIRECT_URL=
NOTARX_OIDC_SCOPES="openid profile email"
NOTARX_OIDC_ADMIN_SUBJECTS=
# Optional Keycloak realm-role mappings onto the two assignable account levels.
# No role mapping is enabled unless the corresponding list is explicitly
# configured. A member mapping approves the account without granting repository
# access; repository reach always comes from per-repository grants.
NOTARX_OIDC_MEMBER_ROLES=
NOTARX_OIDC_ADMIN_ROLES=
# Optional OpenTelemetry OTLP/HTTP collector endpoint (host:port) and head
# sampling ratio between 0 and 1. Without an endpoint, traces are unsampled.
NOTARX_OTLP_HTTP_ENDPOINT=
NOTARX_OTEL_SAMPLING_RATIO=1
NOTARX_GITEA_USERNAME=replace-with-a-gitea-read-username
NOTARX_GITEA_TOKEN=replace-with-a-gitea-read-token
NOTARX_OCI_PROXY_ALLOWED_HOSTS=
NOTARX_MAVEN_PROXY_ALLOWED_HOSTS=
NOTARX_RAW_PROXY_ALLOWED_HOSTS=
# Optional maximum cached object size in bytes for Raw and Conan Proxy reads.
# Each defaults to 1073741824 (1 GiB) when unset.
NOTARX_RAW_CACHE_MAX_OBJECT_BYTES=
# Maximum simultaneous Raw cache-miss staging files per Gateway process.
# Defaults to 4; worst-case temporary space is this value multiplied by the
# Raw maximum object size.
NOTARX_RAW_CACHE_MAX_CONCURRENT_SPOOLS=
NOTARX_CONAN_CACHE_MAX_OBJECT_BYTES=
# Optional proxy cache TTL per format, as a Go duration ("30m", "1h30m") or a
# positive integer number of seconds ("900"). OCI, Raw, and Conan default to
# 15m. Maven components default to 24h; Maven metadata and negative responses
# have independent defaults of 15m and 10m. npm metadata and negative responses
# default to 15m and 10m; its upstream circuit breaker defaults to 30s.
NOTARX_OCI_CACHE_TTL=
NOTARX_MAVEN_CACHE_TTL=
NOTARX_MAVEN_METADATA_CACHE_TTL=
NOTARX_MAVEN_NEGATIVE_CACHE_TTL=
NOTARX_NPM_METADATA_CACHE_TTL=
NOTARX_NPM_NEGATIVE_CACHE_TTL=
NOTARX_NPM_PROXY_BREAKER_TTL=
NOTARX_RAW_CACHE_TTL=
NOTARX_CONAN_CACHE_TTL=
# RustFS credentials are independent. RUSTFS_RPC_SECRET must differ from the
# object-storage secret and should be a random value of at least 32 characters.
RUSTFS_ACCESS_KEY=replace-with-a-local-rustfs-access-key
RUSTFS_SECRET_KEY=replace-with-a-local-rustfs-secret-key
RUSTFS_RPC_SECRET=replace-with-an-independent-rustfs-rpc-secret
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Default off. Absolute relay JSON for binary deployments; compose.yml alone
# does not forward this value. Opt-in Compose uses compose.email.yml and the
# directory below, with relay.json inside. Never put SMTP credentials here.
NOTARX_EMAIL_CONFIG_FILE=
NOTARX_EMAIL_CONFIG_DIR=

# Operator-only exact host=RFC1918/ULA-CIDR rules for private Nexus source reads.
NOTARX_MIGRATION_SOURCE_PRIVATE_ENDPOINTS=

# Explicit real object-storage pool identity enables durable Nexus migration.
# Capacity bytes still require fresh operator-reported evidence per batch/resume.
NOTARX_MIGRATION_STORAGE_POOL_ID=
