FROM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
ARG VERSION=dev
ARG REVISION=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,id=notarx-go-mod,target=/go/pkg/mod,sharing=locked \
    go mod download
COPY . .
RUN --mount=type=cache,id=notarx-go-mod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=notarx-go-build,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false \
    -ldflags="-s -w -X github.com/mlops-ca/notarx/internal/buildinfo.injectedVersion=$VERSION -X github.com/mlops-ca/notarx/internal/buildinfo.injectedRevision=$REVISION" \
    -o /notarxctl ./cmd/notarxctl

# Client-only payload: the distroless static image carries CA certificates and
# /etc/passwd, and nothing of the server distribution. HOME points at the
# nonroot home so a profile file can be mounted at ~/.config/notarxctl/config.yaml.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
ARG VERSION=dev
ARG REVISION=unknown
ARG SOURCE=https://github.com/mlops-ca/notarx
LABEL org.opencontainers.image.title="notarx CLI" \
      org.opencontainers.image.description="notarxctl client for CI pipelines, platform management, and agents" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.source="$SOURCE"
COPY --from=build /notarxctl /notarxctl
ENV HOME=/home/nonroot
USER nonroot:nonroot
ENTRYPOINT ["/notarxctl"]
