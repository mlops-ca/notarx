{
  "name": "notarx-console",
  "private": true,
  "version": "0.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-no-external-assets.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "i18n:prune:check": "node scripts/i18n-prune.mjs --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:api": "openapi-ts -f hey-api.config.ts && prettier --ignore-path /dev/null --write src/client/types.gen.ts",
    "check:api": "npm run generate:api",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/plots": "^2.6.8",
    "@tanstack/react-query": "^5.107.1",
    "antd": "^6.7.0",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cspell/dict-en-ca": "^1.0.69",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "cspell": "^10.5.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "js-yaml": "5.4.2",
    "nanoid": "3.3.18",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
