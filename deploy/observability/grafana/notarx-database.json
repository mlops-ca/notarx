{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus that scrapes notarx and postgres_exporter",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "notarx-database",
  "title": "notarx database",
  "description": "PostgreSQL statement cost, table bloat, partitions and retention lag (ADR 0023 section 11). Needs the notarx /metrics endpoint and postgres_exporter with the stat_statements collector.",
  "tags": [
    "notarx",
    "postgresql"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "pg_stat_statements",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Top statements by total time",
      "description": "Execution seconds per second spent in each statement, top 10 over 5 minutes. Needs pg_stat_statements.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, sum by (queryid, query) (rate(pg_stat_statements_seconds_total[5m])))",
          "legendFormat": "{{queryid}} {{query}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Top statements by calls",
      "description": "Calls per second of the ten busiest statements.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, sum by (queryid, query) (rate(pg_stat_statements_calls_total[5m])))",
          "legendFormat": "{{queryid}} {{query}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rows per call",
      "description": "Mean rows returned or affected per call for the ten statements that touch the most rows; a rising value flags a missing LIMIT or index.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, sum by (queryid, query) (rate(pg_stat_statements_rows_total[5m])) / sum by (queryid, query) (rate(pg_stat_statements_calls_total[5m])))",
          "legendFormat": "{{queryid}} {{query}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Tables, partitions and retention",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Dead tuples",
      "description": "Dead tuples of the ten tables with the most; vacuum is falling behind when a table grows steadily.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, pg_stat_user_tables_n_dead_tup)",
          "legendFormat": "{{relname}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Partition count",
      "description": "Bounded partitions per managed audit table (notarx_partitions); it should stay at the retention window plus notarx_partition_ahead.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "notarx_partitions",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Default-partition rows",
      "description": "Rows that landed in a DEFAULT partition; must be 0, a non-zero value means the partition manager is not keeping up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "notarx_partition_default_rows",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Retention lag",
      "description": "Seconds by which the oldest remaining row of each retained table is older than its retention window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "notarx_retention_lag_seconds",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Retention deletions",
      "description": "Rows deleted per second by the retention janitor.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (table) (rate(notarx_retention_deleted_rows_total[5m]))",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Audit flush p99",
      "description": "99th percentile of the audit writer batch flush duration; ADR 0023 targets 5 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(notarx_audit_flush_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
