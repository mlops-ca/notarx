# Copy to .env (mode 0600, never committed) and fill in. Generate each secret
# with: openssl rand -hex 32
#
# DNS name that points at the VM's public IP (an A record); Caddy gets its
# certificate for it automatically.
NOTARX_DOMAIN=
NOTARX_ACME_EMAIL=

NOTARX_POSTGRES_PASSWORD=
NOTARX_ADMIN_TOKEN=
NOTARX_RESOLVER_TOKEN=
NOTARX_SETTINGS_ENCRYPTION_KEY=
NOTARX_SETTINGS_ENCRYPTION_KEY_PREVIOUS=
NOTARX_EGRESS_PROXY_KEY=
NOTARX_CONAN_TOKEN_SECRET=

# Optional. Defaults are in compose.yml (the release bundle replaces the project
# image defaults there with digest pins). Setting one of these overrides that
# default, including a digest pin.
# NOTARX_IMAGE=
# NOTARX_CONSOLE_IMAGE=
# NOTARX_POSTGRES_IMAGE=
# NOTARX_CADDY_IMAGE=
# NOTARX_DATA_DIR=/srv/notarx

# Running from a repository clone (pre-release path) instead of the bundle:
# NOTARX_MIGRATIONS_DIR=../../migrations
# NOTARX_MIGRATION_RUNNER=../../scripts/run-migrations.sh
