# Remote, encrypted state. The state contains the backup user's customer secret
# key, so never keep it only on a laptop and never commit it. Copy this file to
# backend.tf and fill in your bucket. Credentials come from the environment
# (AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY of a customer secret key that can
# manage objects in the state bucket), not from this file.
terraform {
  backend "s3" {
    bucket   = "REPLACE-state-bucket"
    key      = "notarx/oci-free-tier.tfstate"
    region   = "ca-toronto-1"
    endpoints = {
      s3 = "https://REPLACE-namespace.compat.objectstorage.ca-toronto-1.oraclecloud.com"
    }
    use_path_style              = true
    skip_region_validation      = true
    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_s3_checksum            = true
  }
}

# Client-side state encryption (OpenTofu 1.7+), on top of the bucket's own
# encryption. Supply the configuration through the TF_ENCRYPTION environment
# variable so no passphrase is written to disk:
#
#   export TF_ENCRYPTION='
#   key_provider "pbkdf2" "state" { passphrase = "<generate with: openssl rand -base64 32>" }
#   method "aes_gcm" "state" { keys = key_provider.pbkdf2.state }
#   state { method = method.aes_gcm.state }
#   plan  { method = method.aes_gcm.state }
#   '
