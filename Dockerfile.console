FROM --platform=$BUILDPLATFORM node:24.13.0-alpine@sha256:cd6fb7efa6490f039f3471a189214d5f548c11df1ff9e5b181aa49e22c14383e AS build
WORKDIR /src/console
COPY console/package.json console/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY console/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.31-alpine@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e
ARG VERSION=dev
ARG REVISION=unknown
ARG SOURCE=https://github.com/mlops-ca/notarx
LABEL org.opencontainers.image.title="Artifact Gateway Console" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.source="$SOURCE"
COPY deploy/kubernetes/console/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/console/dist /usr/share/nginx/html
EXPOSE 8080
