{
  "version": "0.2",
  "language": "en-CA",
  "import": [
    "@cspell/dict-en-ca/cspell-ext.json"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/project-words.txt",
      "addWords": false
