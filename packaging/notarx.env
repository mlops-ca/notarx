# notarx server environment, read by notarx.service and by notarx-migrate.
# Mode 0640 root:notarx; a package upgrade never overwrites this file.
# One KEY=VALUE per line, no quotes, no export, no variable expansion.
# Full reference: https://github.com/mlops-ca/notarx/blob/main/docs/getting-started.md

# Required. PostgreSQL 16 or newer with the pg_trgm extension.
# NOTARX_DATABASE_URL=postgres://notarx:CHANGE_ME@127.0.0.1:5432/notarx?sslmode=require
# Required. Long random secrets.
# NOTARX_ADMIN_TOKEN=
# NOTARX_RESOLVER_TOKEN=

NOTARX_LISTEN_ADDRESS=127.0.0.1:8080

# Object storage: the filesystem driver stores under the service state directory.
NOTARX_OBJECT_STORE_DRIVER=filesystem
NOTARX_OBJECT_STORE_FS_ROOT=/var/lib/notarx/objects
